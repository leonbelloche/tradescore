# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (no NEXT_PUBLIC_): lets the admin and the daily refresh write to the database.
SUPABASE_SECRET_KEY=
# Your admin password for /admin (12+ characters).
ADMIN_PASSWORD=
# Any long random text. Vercel sends it to /api/cron/refresh every morning.
CRON_SECRET=
# Claude (Opus 5.5) for the X studio and the Video studio, from console.anthropic.com. Server only.
ANTHROPIC_API_KEY=
# Publish on X from the admin (developer.x.com app, keys for YOUR account). Server only.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Publish on Instagram from the admin (professional account, developers.facebook.com). Server only.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
